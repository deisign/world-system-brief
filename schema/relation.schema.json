{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://world-system-brief/schema/relation.schema.json",
  "title": "World System Brief Relation",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "issue_id", "from", "predicate", "to", "observed_at", "source_ids", "confidence"],
  "properties": {
    "id": {"type": "string", "pattern": "^REL-[0-9]{6}-[0-9]{2}$"},
    "issue_id": {"type": "string", "pattern": "^WSB-[0-9]{4}$"},
    "from": {"type": "string", "minLength": 1},
    "predicate": {"enum": ["flows_through", "bypasses", "supplies", "constrains", "finances", "enables", "connects", "increases_leverage_of", "decreases_leverage_of", "responds_to"]},
    "to": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date"},
    "valid_from": {"type": ["string", "null"], "format": "date"},
    "valid_to": {"type": ["string", "null"], "format": "date"},
    "state": {"type": "string"},
    "change": {"enum": ["up", "down", "strengthening", "weakening", "stable", "unconfirmed"]},
    "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^CLM-[0-9]{6}-[0-9]{2}$"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "note": {"type": "string"}
  }
}
